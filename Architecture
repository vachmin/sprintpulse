├── apps/
│   ├── api/            # Fastify + Zod REST API, Drizzle ORM, SQLite
│   │   ├── src/
│   │   │   ├── routes/      # HTTP layer only — no queries here
│   │   │   ├── services/    # business logic, authorization helpers
│   │   │   ├── domain/      # pure functions (e.g. story health calculation)
│   │   │   ├── jobs/        # queue, worker loop, job handlers
│   │   │   ├── db/          # Drizzle schema, migrations, connection
│   │   │   └── worker.ts    # separate entrypoint — the background process
│   │   └── drizzle/         # SQL migrations
│   └── web/             # React + Vite + Tailwind + TanStack Query frontend
